# Systemd user unit for the Phase C issue poller.
# Install: see README.md § "Running the issue poller as a systemd user service".
#
# Independent of the worker: a poller crash doesn't take down the worker,
# and vice-versa. Both services should be enabled together.
#
# Scope-tweakable bits:
#   WorkingDirectory  — override if you cloned somewhere other than
#                       $HOME/projects/rae-local-agent.
#   EnvironmentFile   — optional; share the same env file as the worker.
#   ExecStart         — assumes uv is installed per-user at
#                       ~/.local/bin/uv (the astral installer's default).
#
# As of C1, this is a real long-running service: the loop lists issues
# matching `label:local-agent -label:agent-queued -label:agent-invalid`
# on each repo in ~/.config/rae-local-agent/repos.yaml every
# `poll_interval_seconds`, logging what it saw. SIGINT/SIGTERM
# (`systemctl --user stop`) is a clean exit; crashes are retried per
# `Restart=on-failure`. C2 adds body parsing; C3 wires in enqueue.

[Unit]
Description=rae-local-agent GitHub issue poller
Documentation=https://github.com/rae004/rae-local-agent
# Needs GitHub; wait for the network before starting.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/rae-local-agent
EnvironmentFile=-%h/.config/rae-local-agent/env
ExecStart=%h/.local/bin/uv run python issue_poller.py
# Restart on crashes with a backoff. A non-zero exit from the config
# validator will keep retrying; fix the config to break the loop.
Restart=on-failure
RestartSec=5s
# stdlib `logging` writes to stderr; journald captures it.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
